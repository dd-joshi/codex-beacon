{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexbeacon.local/schemas/capabilities-body-v1.schema.json",
  "title": "Codex Beacon CAPABILITIES body v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id", "firmware_version", "cell_count", "color_format",
    "max_keyframes", "max_body_bytes", "max_websocket_bytes", "transitions",
    "timing", "lease", "brightness", "events", "fallback"
  ],
  "properties": {
    "device_id": {"type": "string", "pattern": "^p6-[a-z0-9-]{3,32}$"},
    "firmware_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "cell_count": {"const": 6},
    "color_format": {"const": "rgb888"},
    "max_keyframes": {"type": "integer", "minimum": 1},
    "max_body_bytes": {"type": "integer", "minimum": 1},
    "max_websocket_bytes": {"type": "integer", "minimum": 1},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["step", "linear"]}
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_transition_ms", "max_hold_ms", "max_cycle_ms", "min_loop_cycle_ms", "render_tick_ms"],
      "properties": {
        "max_transition_ms": {"type": "integer", "minimum": 1},
        "max_hold_ms": {"type": "integer", "minimum": 1},
        "max_cycle_ms": {"type": "integer", "minimum": 1},
        "min_loop_cycle_ms": {"type": "integer", "minimum": 1},
        "render_tick_ms": {"type": "integer", "minimum": 1}
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_ms", "max_ms", "default_ms", "keepalive_interval_ms"],
      "properties": {
        "min_ms": {"type": "integer", "minimum": 1},
        "max_ms": {"type": "integer", "minimum": 1},
        "default_ms": {"type": "integer", "minimum": 1},
        "keepalive_interval_ms": {"type": "integer", "minimum": 1}
      }
    },
    "brightness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"const": 0},
        "max": {"type": "integer", "minimum": 1, "maximum": 255}
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["button", "ambient"],
      "properties": {
        "button": {"type": "boolean"},
        "ambient": {"type": "boolean"}
      }
    },
    "fallback": {"const": "off"}
  }
}
