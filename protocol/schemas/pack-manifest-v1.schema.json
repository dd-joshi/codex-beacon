{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peri6.local/schemas/pack-manifest-v1.schema.json",
  "title": "Peri6 pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "display_name",
    "version",
    "host_api",
    "entry_point",
    "maturity",
    "permissions",
    "supported_applications",
    "settings_schema"
  ],
  "properties": {
    "manifest_version": {"const": 1},
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_-]*)+$"
    },
    "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "host_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "min_minor"],
      "properties": {
        "major": {"const": 1},
        "min_minor": {"type": "integer", "minimum": 0}
      }
    },
    "entry_point": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "maturity": {"enum": ["Prototype", "Beta", "Published"]},
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "process.observe",
          "application.loopback.listen",
          "application.loopback.connect",
          "filesystem.read.user_selected",
          "filesystem.read.application_state"
        ]
      }
    },
    "supported_applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version_range"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "version_range": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "settings_schema": {
      "type": "object",
      "required": ["$schema", "type"],
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "type": {"const": "object"}
      }
    }
  }
}
