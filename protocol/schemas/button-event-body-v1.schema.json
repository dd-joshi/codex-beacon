{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexbeacon.local/schemas/button-event-body-v1.schema.json",
  "title": "Codex Beacon BUTTON_EVENT body v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "gesture", "duration_ms"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "gesture": {"enum": ["tap", "press", "long_press"]},
    "duration_ms": {"type": "integer", "minimum": 0}
  }
}
