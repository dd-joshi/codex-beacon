{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexbeacon.local/schemas/load-scene-body-v1.schema.json",
  "title": "Codex Beacon LOAD_SCENE body v1 - legacy device profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene_id", "lease_ms", "brightness", "playback", "keyframes"],
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
    },
    "lease_ms": {"type": "integer", "minimum": 3000, "maximum": 5000},
    "brightness": {"type": "integer", "minimum": 0, "maximum": 96},
    "playback": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "loop"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "on_complete"],
          "properties": {
            "mode": {"const": "once"},
            "on_complete": {"enum": ["hold", "off"]}
          }
        }
      ]
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/keyframe"}
    }
  },
  "$comment": "The executable validator additionally enforces decoded canonical body <=3072 bytes, total cycle <=120000 ms, and loop cycle >=100 ms.",
  "$defs": {
    "rgb": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition", "hold_ms", "cells"],
      "properties": {
        "transition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "duration_ms"],
              "properties": {
                "kind": {"const": "step"},
                "duration_ms": {"const": 0}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "duration_ms"],
              "properties": {
                "kind": {"const": "linear"},
                "duration_ms": {
                  "type": "integer",
                  "anyOf": [
                    {"const": 0},
                    {"minimum": 20, "maximum": 30000}
                  ]
                }
              }
            }
          ]
        },
        "hold_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
        "cells": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/rgb"}
        }
      }
    }
  }
}
