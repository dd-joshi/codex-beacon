{
  "manifest_version": 1,
  "id": "com.peri6.pcactivity",
  "display_name": "PC Activity",
  "version": "0.1.0",
  "host_api": {"major": 1, "min_minor": 0},
  "entry_point": "peri6.packs.pcactivity:create_pack",
  "maturity": "Prototype",
  "permissions": [],
  "supported_applications": [],
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "refresh_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "default": 2
      },
      "show_gpu": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
