{
  "manifest_version": 1,
  "id": "com.codexbeacon.agent",
  "display_name": "Agent",
  "version": "0.1.0",
  "host_api": {"major": 1, "min_minor": 0},
  "entry_point": "codex_beacon.packs.agent:create_pack",
  "maturity": "Prototype",
  "permissions": ["application.loopback.listen"],
  "supported_applications": [
    {"id": "com.openai.codex", "version_range": ">=1"}
  ],
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["listen_port", "bearer_token"],
    "properties": {
      "listen_port": {"type": "integer", "minimum": 1, "maximum": 65535},
      "bearer_token": {"type": "string", "minLength": 32, "maxLength": 128}
    }
  }
}